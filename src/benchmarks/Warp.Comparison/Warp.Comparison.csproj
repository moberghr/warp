<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Warp against Hangfire on the same PostgreSQL, the same machine and the same worker count, run by the
    Comparison workflow (.github/workflows/comparison.yml). README.md says what is measured and how.
    Hangfire is referenced as a package (LGPL-3.0); none of its code is copied here.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);SA1600;SA1601;SA1402;SA1649;SA1502;SA1503;SA1515;SA1516;CA1001;CA1822;CA1859;S1135;S1481;S3459;MA0004;MA0006;MA0038;MA0040;MA0042;MA0048;MA0051;IDE0011</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../core/Warp.Core/Warp.Core.csproj" />
    <ProjectReference Include="../../core/Warp.Worker/Warp.Worker.csproj" />
    <ProjectReference Include="../../core/providers/Warp.Provider.PostgreSql/Warp.Provider.PostgreSql.csproj" />
    <ProjectReference Include="../../core/Warp.SourceGenerator/Warp.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Hangfire.Core" Version="1.8.25" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
  </ItemGroup>
</Project>
