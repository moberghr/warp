<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);SA1600;SA1601;SA1402;SA1649;SA1502;SA1503;SA1515;SA1516;CA1001;CA1822;CA1859;S1135;S1481;S3459;MA0004;MA0006;MA0038;MA0040;MA0042;MA0048;MA0051;IDE0011</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../core/Warp.Core/Warp.Core.csproj" />
    <ProjectReference Include="../../core/Warp.Worker/Warp.Worker.csproj" />
    <ProjectReference Include="../../demo/Warp.Test.Shared/Warp.Test.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.*" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.*" />
    <!-- Override the vulnerable SSH.NET 2025.1.0 (GHSA-q939-rpr3-3284) that Testcontainers pulls
         transitively; 2026.0.0 is patched. Same pin as Warp.Tests — see the comment there. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

</Project>
