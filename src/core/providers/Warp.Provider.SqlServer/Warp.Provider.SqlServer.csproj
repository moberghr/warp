<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageId>Moberg.Warp.Provider.SqlServer</PackageId>
		<Description>SQL Server provider for Moberg.Warp — notification transport (Service Broker), row-lock SQL, distributed lock, and exception classification.</Description>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Warp.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DistributedLock.SqlServer" Version="1.0.7" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.5" />
		<!-- Transitive via Microsoft.Data.SqlClient 6.1.4 (DistributedLock.SqlServer lifts it above EF's 6.1.1), which resolves 9.0.11 — vulnerable to CVE-2026-84008
		     (GHSA-846f-f764-76mx) and CVE-2026-70162 (GHSA-2fmv-rv2c-59x7). Drop once SqlClient depends on a patched build. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Warp.Core\Warp.Core.csproj" />
		<ProjectReference Include="..\..\Warp.Worker\Warp.Worker.csproj" />
	</ItemGroup>

</Project>
