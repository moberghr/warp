<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageId>Moberg.Warp.Adapters.Webhooks</PackageId>
		<Description>Durable outbound webhook delivery for Warp: the host owns subscriptions and fan-out, Warp owns everything after SendAsync — persistence, signing, scheduled retries, tracking, and redelivery, with attempts recorded as warp-webhooks adapter calls.</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Warp.Adapters.Http\Warp.Adapters.Http.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Warp.Tests" />
	</ItemGroup>

</Project>
